{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "module": "Node16",
    "target": "ES2020",
    "lib": ["ES2020"],
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    
  },
  "include": [
    "src/**/*.ts",
    "controllers/**/*.ts",
    "routes/**/*.ts",
    "services/**/*.ts",
    "middleware/**/*.ts",
    "lib/**/*.ts",
    "types/**/*.ts",
    "utils/**/*.ts",
    "validators/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
